{
  "redirects": [
    {
      "source": "/",
      "destination": "/WillBookstoreReact/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/WillBookstoreReact",
      "destination": "/index.html"
    },
    {
      "source": "/WillBookstoreReact/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/WillBookstoreReact/(.*)",
      "destination": "/index.html"
    }
  ]
}
